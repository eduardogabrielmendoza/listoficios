# Aplicacion
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAILS=admin@listoficios.com.ar

# PostgreSQL (Railway inyecta esta variable al vincular el servicio)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/listoficios

# Contacto: 32 bytes codificados en base64
CONTACT_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# Railway Bucket / S3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
